# Copy this file to .env and fill with your real values.

VAPID_PUBLIC_KEY=PASTE_YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=PASTE_YOUR_VAPID_PRIVATE_KEY
# Optional alternative: path to PEM generated by py_vapid
# VAPID_PRIVATE_KEY_PATH=private_key.pem
VAPID_CLAIMS_SUBJECT=mailto:admin@example.com

# Optional backend settings:
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
# OPEN_METEO_TIMEOUT=10
# WEATHER_CACHE_TTL=300
# PUSH_CHECK_INTERVAL_SECONDS=600
# PUSH_ACTIVATION_DELAY_SECONDS=30
